# ==============================================================================
# Edufeedia Platform Environment Configuration Template (.env.example)
# Copy this file to .env and replace with secure values for your environment.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production

# Cryptographic Secret Key for JWT Authentication (generate via `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_character_hex_string

# PostgreSQL Database Credentials
POSTGRES_USER=edufeedia_user
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=edufeedia_db
DATABASE_URL=postgresql://edufeedia_user:generate_a_secure_postgres_password_here@postgres:5432/edufeedia_db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:80

# HuggingFace Model Hub (Optional API token for higher rate limits)
HF_TOKEN=

# Redis Cache URL
REDIS_URL=redis://redis:6379/0
